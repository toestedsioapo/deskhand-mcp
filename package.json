{
  "name": "@marvinliem/deskhand-mcp",
  "version": "0.0.0",
  "description": "MCP server giving AI clients executive-assistant tools, read-only by default with approved writes and an audit ledger.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15"
  },
  "bin": {
    "deskhand-mcp": "dist/server.js",
    "deskhand": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "dev": "node dist/server.js",
    "inspect": "mcp-inspector node dist/server.js",
    "redteam:sandbox": "node scripts/redteam-sandbox.mjs"
  },
  "packageManager": "pnpm@12.15.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@marvinliem/tempo-core": "0.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "1.0.4",
    "@types/node": "~24.19.2",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  }
}
